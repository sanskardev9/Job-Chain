# Supabase — Project Settings > API Keys / Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@your-host:6543/postgres

# Gmail OAuth — Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Used to encrypt stored Gmail tokens. Generate with: openssl rand -hex 32
GMAIL_TOKEN_KEY=your_64_character_hex_key

# JobPilot worker base URL
NEXT_PUBLIC_JOBPILOT_WORKER_URL=https://your-jobpilot-worker.example.com

# Daily JobPilot cron authorization. Generate with: openssl rand -hex 32
CRON_SECRET=your_random_cron_secret

# Browser notifications. Generate both once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
